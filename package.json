{
  "name": "google-workspace-mcp-server",
  "version": "1.0.0",
  "description": "Generic Google Workspace MCP Server for Gmail and Google Docs",
  "type": "module",
  "engines": {
    "node": ">=20"
  },
  "main": "dist/index.js",
  "bin": {
    "google-workspace-mcp": "./dist/index.js"
  },
  "scripts": {
    "build": "tsc",
    "start": "node dist/index.js",
    "dev": "tsx src/index.ts",
    "auth": "tsx scripts/auth.ts",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:integration": "RUN_INTEGRATION_TESTS=1 vitest run tests/integration"
  },
  "keywords": [
    "mcp",
    "google-workspace",
    "gmail",
    "google-docs"
  ],
  "license": "MIT",
  "devDependencies": {
    "@modelcontextprotocol/client": "^2.0.0",
    "@types/node": "^26.4.0",
    "tsx": "^4.23.13",
    "typescript": "^7.0.2",
    "vitest": "^3.2.7"
  },
  "dependencies": {
    "@modelcontextprotocol/server": "^2.0.0",
    "dotenv": "^17.4.2",
    "googleapis": "^176.0.0",
    "zod": "^4.5.4"
  }
}
