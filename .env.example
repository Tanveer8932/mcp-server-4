# Google OAuth
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://localhost:3000/oauth/callback
GOOGLE_TOKEN_STORE_PATH=./tokens.json
# Optional: inline tokens JSON for Railway secrets (alternative to Volume + file path)
# GOOGLE_TOKENS_JSON={"default":{"accessToken":"...","refreshToken":"...","expiryDate":1234567890}}

# MCP transport: stdio | streamable-http
MCP_TRANSPORT=stdio
MCP_HOST=127.0.0.1
MCP_PORT=3000
# Railway injects PORT; MCP_PORT falls back to PORT when unset

# MCP client authentication (required for streamable-http; the server refuses to start without it)
# Comma-separated SHA-256 hex hashes of accepted bearer tokens. Never put the plaintext token here.
# Generate a token + hash with: npm run auth:token
MCP_AUTH_TOKEN_SHA256=

# Tools to expose (default: gmail_create_draft,google_docs_append_content).
# gmail_send_email is opt-in.
# ENABLED_TOOLS=gmail_create_draft,google_docs_append_content

# OAuth routes (/oauth/start, /oauth/callback). Off by default (404).
# Prefer `npm run auth` locally + GOOGLE_TOKENS_JSON. If enabled, all three below are required.
ENABLE_OAUTH_ROUTES=false
# OAUTH_ADMIN_TOKEN_SHA256=       # hash of a separate admin token (npm run auth:token)
# OAUTH_STATE_SECRET=             # >= 32 random chars, e.g. `openssl rand -base64 48`
# ALLOWED_GOOGLE_ACCOUNT=         # only this Google account may complete the OAuth flow

# Observability & limits
LOG_LEVEL=info
MAX_EMAIL_BODY_BYTES=1048576
MAX_DOC_APPEND_BYTES=1048576

# Remote verification (scripts/verify-server.ts)
# MCP_URL=https://your-app.up.railway.app
# MCP_AUTH_TOKEN=                 # plaintext client token matching a hash in MCP_AUTH_TOKEN_SHA256
