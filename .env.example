# Google OAuth
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://localhost:3000/oauth/callback
GOOGLE_TOKEN_STORE_PATH=./tokens.json
# Optional: inline tokens JSON for Railway secrets (alternative to Volume + file path)
# GOOGLE_TOKENS_JSON={"default":{"accessToken":"...","refreshToken":"...","expiryDate":1234567890}}

# MCP transport: stdio | streamable-http
MCP_TRANSPORT=stdio
MCP_HOST=127.0.0.1
MCP_PORT=3000
# Railway injects PORT; MCP_PORT falls back to PORT when unset

# Observability & limits
LOG_LEVEL=info
MAX_EMAIL_BODY_BYTES=1048576
MAX_DOC_APPEND_BYTES=1048576

# Remote verification (scripts/verify-server.ts)
# MCP_URL=https://your-app.up.railway.app
